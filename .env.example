NODE_ENV=development
PAGEPASS_PORT=8787

PAGEPASS_DB_NAME=pagepass
PAGEPASS_DB_USER=pagepass
PAGEPASS_DB_PASSWORD=replace-with-a-local-password
PAGEPASS_DB_PORT=54329
DATABASE_URL=postgresql://pagepass:replace-with-a-local-password@localhost:54329/pagepass
TEST_DATABASE_URL=postgresql://pagepass:replace-with-a-local-password@localhost:54329/pagepass_test

PAGEPASS_S3_ACCESS_KEY=pagepass-local
PAGEPASS_S3_SECRET_KEY=replace-with-a-local-storage-password
PAGEPASS_S3_PORT=9010
PAGEPASS_S3_CONSOLE_PORT=9001

# Use the Mac's LAN address instead of localhost when uploading from an iPhone.
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=pagepass-private-media
S3_ACCESS_KEY_ID=pagepass-local
S3_SECRET_ACCESS_KEY=replace-with-a-local-storage-password
S3_FORCE_PATH_STYLE=true

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_TRUSTED_ORIGINS=pagepass://auth,http://localhost:8787

# Optional in development; required in production.
RESEND_API_KEY=
EMAIL_FROM=PagePass <no-reply@example.com>

# Optional until Sign in with Apple is configured.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional until parent push notifications are configured. Keep the .p8 file
# outside source control and provide only its local or mounted path here.
APNS_PRIVATE_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.pagepass.app

# Legacy native authentication remains during the Better Auth migration.
PAGEPASS_AUTH_MODE=local
PAGEPASS_PARENT_TOKEN=replace-with-a-local-parent-token
PAGEPASS_SERVER_PEPPER=replace-with-a-local-server-pepper
PAGEPASS_TRUST_PROXY=false

# Optional operational alert thresholds used by `pnpm ops:check`.
PAGEPASS_OPS_MAX_PUSH_DUE=100
PAGEPASS_OPS_MAX_PUSH_DELAY_SECONDS=300
PAGEPASS_OPS_MAX_PUSH_FAILED=10
PAGEPASS_OPS_MAX_PUSH_PROCESSING_SECONDS=300
PAGEPASS_OPS_MAX_MEDIA_DUE=100
PAGEPASS_OPS_MAX_MEDIA_DELAY_SECONDS=3600
PAGEPASS_OPS_MAX_MEDIA_ATTEMPTS=10
PAGEPASS_OPS_MAX_MEDIA_PROCESSING_SECONDS=300

# Production startup is fail-closed. Set NODE_ENV=production, use HTTPS for
# BETTER_AUTH_URL, trusted web origins, and S3_ENDPOINT, and configure Resend,
# Apple authentication, all APNS_* values, and all S3_* values. Use
# PAGEPASS_AUTH_MODE=apple; local parent credentials are development-only.
